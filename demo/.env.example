# Copy to demo/.env and fill in. Never commit demo/.env.
# All values are read from the environment (real env vars win over this file).

# --- D1 side -------------------------------------------------------------
# 10-char code of the poll group Carlos creates (the /p/<GROUP_CODE> URL)
GROUP_CODE=
# Absolute path to the h1sort-website checkout (wrangler runs with this cwd)
H1SORT_SITE=
# Secret salt for VOTER_KEY = sha256(VOTER_SALT + voter_hash). Any long random string;
# keep it the same for the whole demo and never share it.
VOTER_SALT=

# --- Snowflake -----------------------------------------------------------
# Account identifier, e.g. ORGNAME-ACCOUNTNAME
SNOWFLAKE_ACCOUNT=
# User that owns the programmatic access token (needs the SWT_LOADER role)
SNOWFLAKE_USER=
# Programmatic access token (PAT). Key-pair auth is optional and not used by the bridge.
SNOWFLAKE_PAT=
# Role used by the bridge (INSERT/UPDATE/MERGE on SWT_DEMO.RAW)
SNOWFLAKE_ROLE_LOADER=SWT_LOADER
# Role used by the harness (read-only on SWT_DEMO.SEM + the agent)
SNOWFLAKE_ROLE_AGENT=SWT_AGENT_RO
SNOWFLAKE_WAREHOUSE=SWT_WH

# --- Cortex / harness ----------------------------------------------------
# Claude model id used by the agent/judge/act calls (must be available in the account's region)
CORTEX_MODEL=

# --- h1sort.com admin (used by the harness to close the group) -----------
POLLS_ADMIN_USERNAME=
POLLS_ADMIN_PASSWORD=
H1SORT_BASE=https://h1sort.com

# --- Optional bridge knobs (not part of the shared contract) -------------
# Seconds between D1 polls (default 3)
# BRIDGE_INTERVAL=3
# How the PAT is sent: auto (default: as password, then authenticator=PROGRAMMATIC_ACCESS_TOKEN),
# password, or token
# SNOWFLAKE_PAT_AUTH=auto
